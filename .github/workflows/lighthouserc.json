{
  "ci": {
    "collect": {
      "staticDistDir": "./",
      "url": "/index.html#0000ff"
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "uses-rel-preconnect": "off",
        "uses-passive-event-listeners": "off",
        "color-contrast": "warn",
        "font-size": "warn",
        "network-dependency-tree-insight": "warn"
      }
    }
  }
}
